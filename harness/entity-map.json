      "to": "OutwardGateway",
      "rule": "对外会话全量审计"
    },
    "LifeWake_to_ExperienceProtocols": {
      "from": "SelfPawExperienceDomain",
      "to": "ExperienceProtocolContracts",
      "rule": "lw.* 保持领域隔离，通过 adapter 产出 G/E/Π 通用记录"
    },
    "WorkStudio_to_Hub": {

      "rule": "只调 hub.*；禁止零件 SDK"
    },
    "Hub_to_Capabilities": {
      "from": "CapabilityHub",
      "to": "CapabilityService",
      "rule": "写生产仅 runtime + MCP/cs.*；场景禁写"
    },
    "Lethe_isolation": {

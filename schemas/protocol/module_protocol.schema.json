{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uas-aios.local/schemas/protocol/module_protocol.schema.json",
  "title": "UAS-AIOS module protocol registry",
  "type": "object",
  "required": ["version", "envelope", "policy_order", "modules"],
  "properties": {
    "version": { "type": "string" },
    "envelope": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 6
    },
    "policy_order": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 8
    },
    "front_forbidden_nouns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "modules": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "layer",
          "decision",
          "replaceable",
          "protocol_id",
          "hub_methods",
          "port",
          "verbs",
          "errors",
          "forbidden"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^M([1-9]|1[0-9]|2[0-4])$" },
          "name": { "type": "string" },
          "layer": { "type": "string" },
          "decision": { "enum": ["own", "own-shell", "own-contract", "integrate", "connect", "optional"] },
          "replaceable": { "type": "boolean" },
          "protocol_id": { "type": "string" },
          "hub_methods": { "type": "array", "items": { "type": "string" } },
          "port": { "type": ["string", "null"] },
          "verbs": { "type": "array", "items": { "type": "string" } },
          "in": { "type": "object" },
          "out": { "type": "object" },
          "errors": { "type": "array", "items": { "type": "string" } },
          "forbidden": { "type": "array", "items": { "type": "string" } },
          "front_nouns": { "type": "array", "items": { "type": "string" } },
          "part": { "type": "string" },
          "fixture": { "type": ["string", "null"] }
        }
      }
    }
  }
}
